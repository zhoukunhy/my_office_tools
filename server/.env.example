# 环境变量示例，可复制为 .env 再修改
# 监听地址
HOST=127.0.0.1
PORT=8000
# 单文件上传上限（MB）
MAX_UPLOAD_MB=200
# 允许的跨域来源，多个以逗号分隔；默认 * 即不限制（同源部署即可）
CORS_ORIGINS=*
# 日志等级
LOG_LEVEL=INFO
# ---------- AI 生成 PPT（OpenAI 兼容接口，DeepSeek/通义/Kimi/OpenAI 均可） ----------
# 接口地址，如 https://api.deepseek.com/v1 或 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
# API Key（必填，未配置时 AI PPT 功能返回 503）
LLM_API_KEY=
# 模型名，如 deepseek-chat / qwen-plus / gpt-4o-mini
LLM_MODEL=deepseek-chat
# 每页并发生成数（进程内信号量，默认 4）
AI_PPT_CONCURRENCY=4
